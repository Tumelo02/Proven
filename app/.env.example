# TEMPLATE ONLY. Never put real keys in this file: it is committed to git.
#
# Copy it to `.env.local` and fill the real values in there instead.
# `.env.local` is gitignored, which is what keeps your keys out of the
# repository.
#
#   cp .env.example .env.local
#
# Values come from your Supabase project, under Settings -> API keys.
# See supabase/SETUP.md, step 5.

# Project URL. Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / publishable key. Safe in the browser: every request it makes is
# constrained by the row-level security rules in supabase/migrations/.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# service_role / secret key. SERVER ONLY.
# This BYPASSES every security rule. It must never appear in browser code, in
# this repository, or in any NEXT_PUBLIC_ variable. If it leaks, rotate it
# immediately under Settings -> API keys.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
